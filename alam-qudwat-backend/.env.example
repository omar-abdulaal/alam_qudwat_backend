# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string (psycopg3 driver). Must point at a database
# with the "vector" extension available (pgvector).
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/alam_qudwat

# OpenAI API key used for embeddings, chat generation, and transcription.
# NEVER put a real key in this .example file — it's meant to be safe to commit.
OPENAI_API_KEY=sk-...

# Embedding model + dimension. Keep EMBEDDING_DIM in sync with the model
# (text-embedding-3-small -> 1536, text-embedding-3-large -> 3072) — changing
# this requires a new Alembic migration to alter the vector column width.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Chunking parameters (token counts, measured with tiktoken cl100k_base).
CHUNK_TOKEN_SIZE=400
CHUNK_TOKEN_OVERLAP=60
CHUNK_MIN_TOKEN_SIZE=40

# How many chunks to send to the embeddings API per request.
EMBEDDING_BATCH_SIZE=64

# --- Grounded chat generation (rag/generation, used by the backend API) ---
CHAT_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0.3
# Max chunks retrieved per question, and the minimum cosine-similarity score
# a top result must reach before the LLM is even called (below this, the
# backend returns an honest "sources don't cover this" reply — no LLM call).
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.28

# --- Backend API (app/) ---
# Shared-secret bearer token the Flutter app must send as
# "Authorization: Bearer <token>" on every /api/v1/* request.
API_AUTH_TOKEN=change-me-to-a-long-random-value

# Comma-separated list of allowed CORS origins, or "*" for any (fine for a
# mobile-only client; tighten this if/when a web client is added).
CORS_ALLOW_ORIGINS=*

# How many prior chat turns (user+assistant messages) to load from Postgres
# as conversation context on each new message.
HISTORY_MAX_MESSAGES=8

MAX_MESSAGE_LENGTH=2000
LOG_LEVEL=INFO

# --- Speech-to-text (POST /api/v1/stt/transcribe) ---
STT_MODEL=gpt-4o-mini-transcribe
STT_MAX_AUDIO_BYTES=26214400

# --- Text-to-speech / SILMA on SageMaker (POST /api/v1/tts/speak) ---
# Requires standard AWS credentials too (AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY, or an IAM role) — picked up by boto3's normal
# default credential chain, not read by this app's own settings.
SILMA_SAGEMAKER_ENDPOINT_NAME=
AWS_REGION=us-east-1
TTS_DEFAULT_VOICE_ID=pixel
TTS_MAX_TEXT_LENGTH=1000

# --- Startup RAG sync ---
# Root directory scanned for dataset subdirectories (e.g. data/raw/rashidun,
# data/raw/companions_tier1) by the backend's automatic startup ingestion.
RAG_DATA_DIR=data/raw
# Ingest any character missing from the DB in a background thread on every
# backend startup — never blocks the API from serving requests. Set to
# false for a scaled-out/read-only instance, or to avoid an automatic
# OpenAI bill on every local dev reload.
AUTO_INGEST_ON_STARTUP=true

# --- Startup character-classification sync ---
# Apply data/generated/character_classifications.json (produced locally by
# scripts/export_character_classifications.py, committed to the repo) to
# characters.categories/short_description synchronously on every backend
# startup. Makes no external API calls — safe to leave on everywhere,
# including servers that don't have OPENAI_API_KEY set.
AUTO_SYNC_CLASSIFICATIONS_ON_STARTUP=true
